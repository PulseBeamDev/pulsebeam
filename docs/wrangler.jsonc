{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "pulsebeam-docs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../bazel-bin/docs/.vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.pulsebeam.dev", "custom_domain": true }
  ],
  "previews": {}
}
