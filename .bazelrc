startup --max_idle_secs=300
startup --shutdown_on_low_sys_mem

common --enable_bzlmod
common --lockfile_mode=error
common --repo_contents_cache=~/.cache/pulsebeam/bazel/repo-contents-cache
common --watchfs
common --repo_env=PULSEBEAM_WEBRTC_SOURCE_ARCHIVE
common --repo_env=PULSEBEAM_WEBRTC_NATIVE_ARCHIVE
build --disk_cache=~/.cache/pulsebeam/bazel/disk-cache
build --incompatible_strict_action_env
build --announce_rc
build --workspace_status_command=tools/simulation-status.sh
build --@rules_python//python/config_settings:bootstrap_impl=script
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:extra_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable,-Cforce-frame-pointers=yes
build --@rules_rust//rust/settings:extra_exec_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable
test --nobuild_runfile_links
build:dev --compilation_mode=dbg
build:dev --@rules_rust//rust/settings:extra_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable,-Cforce-frame-pointers=yes,-Cpanic=abort,-Cdebug-assertions=yes,-Coverflow-checks=yes
build:profile --compilation_mode=opt
build:profile --strip=never
build:profile --@rules_rust//rust/settings:lto=thin
build:profile --@rules_rust//rust/settings:extra_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable,-Cforce-frame-pointers=yes,-Cdebuginfo=2,-Cpanic=abort,-Cdebug-assertions=no,-Coverflow-checks=no
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:lto=thin
build:release --@rules_rust//rust/settings:extra_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable,-Cforce-frame-pointers=yes,-Cpanic=abort,-Cdebug-assertions=no,-Coverflow-checks=no,-Ccodegen-units=16
build:sim --compilation_mode=opt
build:sim --@rules_rust//rust/settings:extra_rustc_flags=--cfg=tokio_unstable,--cfg=tracing_unstable,-Cforce-frame-pointers=yes,-Cdebug-assertions=yes,-Coverflow-checks=yes
