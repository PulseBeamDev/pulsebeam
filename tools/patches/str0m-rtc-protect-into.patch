+/// Packet storage required by the selected, derived cipher.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SrtpProtectionLayout {
+    pub wire_bytes: usize,
+    /// Includes CTR tail workspace, not allocator capacity or provider-internal storage.
+    pub initialized_bytes: usize,
+}
+
+fn protection_layout(
+    cipher: &Derived,
+    plaintext: usize,
+    index_bytes: usize,
+) -> Option<SrtpProtectionLayout> {
+    let tag = match cipher {
+        Derived::Aes128CmSha1_80 { .. } => Aes128CmSha1_80::HMAC_TAG_LEN,
+        Derived::AeadAes128Gcm { .. } => AeadAes128Gcm::TAG_LEN,
+        Derived::AeadAes256Gcm { .. } => AeadAes256Gcm::TAG_LEN,
+    };
+    let wire_bytes = plaintext.checked_add(index_bytes)?.checked_add(tag)?;
+    let initialized_bytes = if matches!(cipher, Derived::Aes128CmSha1_80 { .. }) {
+        plaintext.checked_add(CTR_BUFFER_PADDING)?
+    } else {
+        wire_bytes
+    };
+    Some(SrtpProtectionLayout {
+        wire_bytes,
+        initialized_bytes,
+    })
+}
