+    /// Limits complete message length and retained partial payload on one receive stream.
+    /// Set before enabling the stream and remove only after closing and resetting it.
+    /// Ambiguous traditional unordered fragments share the same partial payload budget.
+    pub fn set_receive_budget(&mut self, stream: StreamId, limit: Option<std::num::NonZeroUsize>) {
