+    /// Waits for an item or terminal closure without consuming a queue slot.
+    ///
+    /// Cancellation leaves every item in the queue. Returns false only when
+    /// the channel is closed and drained.
+    pub async fn readable(&mut self) -> bool {
+        std::future::poll_fn(|cx| {
+            // Safety: the exclusive receiver borrow serializes queue inspection
+            // and waker registration, just as in Stream::poll_next.
+            unsafe {
+                match self.inner.queue.readable() {
+                    Ok(()) => return Poll::Ready(true),
+                    Err(PopError::Closed) => return Poll::Ready(false),
+                    Err(PopError::Empty) => {}
+                }
+
+                self.inner.receiver_signal.register(cx.waker());
+
+                // Recheck after registration so sends and last-sender drops
+                // racing with registration cannot strand the receiver.
+                match self.inner.queue.readable() {
+                    Ok(()) => {
+                        self.inner.receiver_signal.unregister();
+                        Poll::Ready(true)
+                    }
+                    Err(PopError::Closed) => {
+                        self.inner.receiver_signal.unregister();
+                        Poll::Ready(false)
+                    }
+                    Err(PopError::Empty) => Poll::Pending,
+                }
+            }
+        })
+        .await
+    }
