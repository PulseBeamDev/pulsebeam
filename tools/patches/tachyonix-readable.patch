+    /// Checks the next slot without popping it or releasing capacity.
+    ///
+    /// # Safety
+    ///
+    /// Like pop, this must not run concurrently with another consumer.
+    pub(super) unsafe fn readable(&self) -> Result<(), PopError> {
+        let dequeue_pos = self.dequeue_pos.with(|p| *p);
+        let slot = &self.buffer[dequeue_pos & self.right_mask];
+        let stamp = slot.stamp.load(Ordering::Acquire);
+
+        if dequeue_pos != stamp {
+            Ok(())
+        } else if self.enqueue_pos.load(Ordering::Relaxed)
+            == (dequeue_pos | self.closed_channel_mask)
+        {
+            // As in pop, closure is terminal only after any producer that
+            // reserved this slot has published its value.
+            Err(PopError::Closed)
+        } else {
+            Err(PopError::Empty)
+        }
+    }
