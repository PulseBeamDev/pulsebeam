+//! Opt-in, thread-local controls at host and UDP execution boundaries.
+//!
+//! With no guard installed all upstream scheduling and transport policies remain
+//! unchanged. TCP segments are never exposed as reorderable datagrams.
+use std::{
+    cell::RefCell,
+    marker::PhantomData,
+    net::{IpAddr, SocketAddr},
+    rc::Rc,
+    time::Duration,
+};
+
+/// An actual execution boundary, with the live inputs available there.
+pub enum Event<'a> {
+    Hosts {
+        step: usize,
+        runnable: &'a [IpAddr],
+    },
+    Udp {
+        src: SocketAddr,
+        dst: SocketAddr,
+        bytes: &'a [u8],
+    },
+    UdpPair {
+        src: SocketAddr,
+        dst: SocketAddr,
+        first: &'a [u8],
+        second: &'a [u8],
+    },
+    UdpDelivered {
+        src: SocketAddr,
+        dst: SocketAddr,
+        bytes: &'a [u8],
+    },
+}
+
+/// A local intervention. Invalid event/decision combinations are rejected.
+#[derive(Clone, Copy, Debug, Default)]
+pub enum Decision {
+    #[default]
+    Default,
+    Hosts {
+        reverse: bool,
+    },
+    Udp {
+        delay: Duration,
+        drop: bool,
+        duplicate: bool,
+    },
+    UdpPair {
+        reverse: bool,
+    },
+}
+
+type Hook = Box<dyn for<'a> FnMut(Event<'a>) -> Decision>;
+thread_local! {
+    static HOOK: RefCell<Option<Hook>> = const { RefCell::new(None) };
+}
+
+/// Removes the control on drop, including unwinding. It cannot cross threads.
+pub struct Guard(PhantomData<Rc<()>>);
+
+/// Install a control for this simulation thread. Nested controls are an error.
+pub fn install(hook: impl for<'a> FnMut(Event<'a>) -> Decision + 'static) -> Guard {
+    HOOK.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        assert!(slot.is_none(), "nested exploration control");
+        *slot = Some(Box::new(hook));
+    });
+    Guard(PhantomData)
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        HOOK.with(|slot| *slot.borrow_mut() = None);
+    }
+}
+
+pub(crate) fn active() -> bool {
+    HOOK.with(|slot| slot.borrow().is_some())
+}
+
+pub(crate) fn choose(event: Event<'_>) -> Decision {
+    HOOK.with(|slot| match slot.borrow_mut().as_mut() {
+        Some(hook) => hook(event),
+        None => Decision::Default,
+    })
+}
