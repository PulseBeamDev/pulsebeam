+    /// Number of application records in the last emitted DTLS 1.3 packet.
+    /// Read immediately after `poll_output` returns `Output::Packet`. Other
+    /// versions return zero. This is local provenance, never wire metadata.
+    pub fn last_output_application_records(&self) -> usize {
+        match self.inner.as_ref() {
+            Some(Inner::Client13(client)) => client.last_output_application_records(),
+            Some(Inner::Server13(server)) => server.last_output_application_records(),
+            _ => 0,
+        }
+    }
+
+    /// Length of the datagram that produced the preceding `Output::ApplicationData`,
+    /// if it was a single DTLS 1.3 unified record with a two-byte sequence number,
+    /// explicit length, and no CID. The originating datagram may have arrived
+    /// before the most recent input, for example when application data is reordered
+    /// ahead of Finished. Other versions return `None`.
+    pub fn last_input_application_datagram_len(&self) -> Option<usize> {
+        match self.inner.as_ref() {
+            Some(Inner::Client13(client)) => client.last_input_application_datagram_len(),
+            Some(Inner::Server13(server)) => server.last_input_application_datagram_len(),
+            _ => None,
+        }
+    }
+
+    /// Check the wire shape of a single DTLS 1.3 unified record with a two-byte
+    /// sequence number, explicit length, and no CID, without authenticating it.
+    pub fn single_unified_record_len(datagram: &[u8]) -> Option<usize> {
+        dtls13::incoming::single_unified_record_len(datagram)
+    }
