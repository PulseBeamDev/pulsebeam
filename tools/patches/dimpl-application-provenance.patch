+    /// Number of application records in the last emitted DTLS 1.3 packet.
+    /// Read immediately after `poll_output` returns `Output::Packet`. Other
+    /// versions return zero. This is local provenance, never wire metadata.
+    pub fn last_output_application_records(&self) -> usize {
+        match self.inner.as_ref() {
+            Some(Inner::Client13(client)) => client.last_output_application_records(),
+            Some(Inner::Server13(server)) => server.last_output_application_records(),
+            _ => 0,
+        }
+    }
