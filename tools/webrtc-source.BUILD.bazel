load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])
filegroup(
    name = "provenance",
    srcs = glob(["native/**", "vendor/cxx/**", "tools/cxx/**"]) + [
        "Justfile", "src/lib.rs", "tools/native_cc_wrapper.py",
        "tools/cxx_provenance.py", "tools/native_provenance.py",
    ],
)

rust_library(
    name = "cxx",
    crate_name = "cxx",
    crate_root = "vendor/cxx/src/lib.rs",
    srcs = glob(["vendor/cxx/src/**/*.rs"]),
    edition = "2024",
    crate_features = ["alloc", "std"],
    deps = ["@rtc_libwebrtc//:foldhash"],
    proc_macro_deps = ["@rtc_libwebrtc//:cxxbridge-macro"],
)

rust_library(
    name = "pulsebeam-webrtc-sys",
    crate_name = "pulsebeam_webrtc_sys",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["@pulsebeam//tools:webrtc_candidate_validated"],
    edition = "2024",
    deps = [":cxx", "@pulsebeam//tools:libwebrtc_native"],
)
