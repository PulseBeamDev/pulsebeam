load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "server",
    srcs = ["server.py", "config.py", "resources.py"],
    main = "server.py",
    imports = ["."],
    data = ["@nativelink//:bin", "@webrtc_host//:tools", "@webrtc_host//:host-bin"],
    args = [
        "--binary", "$(rootpath @nativelink//:bin)",
        "--host-bin-file", "$(rootpath @webrtc_host//:host-bin)",
    ],
)

py_test(
    name = "autostart_test",
    srcs = ["test_autostart.py", "autostart.py", "resources.py"],
    main = "test_autostart.py",
    imports = ["."],
)

py_test(
    name = "analyze_test",
    srcs = ["test_analyze.py", "analyze.py"],
    main = "test_analyze.py",
    imports = ["."],
)

py_test(
    name = "resources_test",
    srcs = ["test_resources.py", "resources.py"],
    main = "test_resources.py",
    imports = ["."],
)

py_test(
    name = "config_test",
    srcs = ["test_config.py", "config.py", "server.py", "resources.py"],
    main = "test_config.py",
    imports = ["."],
)
