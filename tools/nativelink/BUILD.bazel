load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])
exports_files(["server.py"])

py_binary(
    name = "server",
    srcs = ["server.py", "config.py", "resources.py"],
    main = "server.py",
    imports = ["."],
    data = ["@nativelink//:bin", "@webrtc_host//:tools", "@webrtc_host//:host-bin", "@host_runtime//:tools", "@host_runtime//:runtime-root"],
    args = [
        "--binary", "$(rootpath @nativelink//:bin)",
        "--host-bin-file", "$(rootpath @webrtc_host//:host-bin)",
        "--runtime-root-file", "$(rootpath @host_runtime//:runtime-root)",
    ],
)

py_test(
    name = "autostart_test",
    srcs = ["test_autostart.py", "autostart.py", "resources.py"],
    main = "test_autostart.py",
    imports = ["."],
)

py_test(
    name = "analyze_test",
    srcs = ["test_analyze.py", "analyze.py"],
    main = "test_analyze.py",
    imports = ["."],
)

py_test(
    name = "siso_summary_test",
    srcs = ["test_siso_summary.py", "siso_summary.py"],
    main = "test_siso_summary.py",
    imports = ["."],
)

py_test(
    name = "reapi_integration_test",
    srcs = ["test_reapi_integration.py"],
    main = "test_reapi_integration.py",
    args = [
        "--server", "$(rootpath :server.py)",
        "--binary", "$(rootpath @nativelink//:bin)",
        "--host-bin-file", "$(rootpath @webrtc_host//:host-bin)",
        "--runtime-root-file", "$(rootpath @host_runtime//:runtime-root)",
        "--source-manifest", "$(rootpath @webrtc_upstream//:sources.sha256)",
    ],
    data = ["analyze.py", "config.py", "resources.py", "server.py", "@nativelink//:bin", "@webrtc_host//:tools", "@webrtc_host//:host-bin", "@host_runtime//:tools", "@host_runtime//:runtime-root", "@webrtc_upstream//:sources.sha256"],
    size = "medium",
    tags = ["local", "manual"],
)

py_test(
    name = "resources_test",
    srcs = ["test_resources.py", "resources.py"],
    main = "test_resources.py",
    imports = ["."],
)

py_test(
    name = "config_test",
    srcs = ["test_config.py", "config.py", "server.py", "resources.py"],
    main = "test_config.py",
    imports = ["."],
)
