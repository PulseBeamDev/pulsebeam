module(name = "pulsebeam", version = "0.3.2")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
register_toolchains("//tools:wasm_bindgen_toolchain")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_llvm", version = "1.10.0")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "nasm", version = "3.02")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.0")
bazel_dep(name = "bazel_lib", version = "3.7.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "rules_pkg", version = "1.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//crates/pulsebeam-rtc/tests/peers/rfc8888:go.mod")
use_repo(go_sdk, "go_default_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//crates/pulsebeam-rtc/tests/peers/rfc8888:go.mod")
use_repo(go_deps, "com_github_pion_rtcp", "com_github_pion_webrtc_v4")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12.11")
use_repo(python, "python_3_12_11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "server_pypi",
    python_version = "3.12.11",
    requirements_lock = "//sdks/python:requirements.lock",
)
use_repo(pip, "server_pypi")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.14.0")
use_repo(node, "nodejs_toolchains")

PNPM_VERSION = "10.12.4"
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(name = "pnpm", pnpm_version = PNPM_VERSION)
use_repo(pnpm, "pnpm", "pnpm__links")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(name = "web_npm", pnpm_lock = "//agents/pulsebeam-agent-web:pnpm-lock.yaml")
npm.npm_translate_lock(name = "react_npm", pnpm_lock = "//agents/react:pnpm-lock.yaml", npm_package_target_name = "package")
npm.npm_translate_lock(name = "consumer_npm", pnpm_lock = "//agents/react/tests/consumer:pnpm-lock.yaml", npm_package_target_name = "package")
npm.npm_translate_lock(name = "meet_npm", pnpm_lock = "//apps/meet:pnpm-lock.yaml", npm_package_target_name = "package")
# Langium imports these transitive packages without declaring them directly.
# Preserve pnpm's compatibility hoist using the existing locked version.
npm.npm_translate_lock(name = "docs_npm", pnpm_lock = "//docs:pnpm-lock.yaml", public_hoist_packages = {"vscode-languageserver-types": ["docs"], "vscode-languageserver-protocol": ["docs"], "vscode-jsonrpc": ["docs"], "@chevrotain/regexp-to-ast": ["docs"], "@chevrotain/types": ["docs"]})
npm.npm_translate_lock(name = "server_npm", pnpm_lock = "//sdks/typescript:pnpm-lock.yaml", npm_package_target_name = "package")
use_repo(npm, "web_npm", "react_npm", "consumer_npm", "meet_npm", "docs_npm", "server_npm")

browsers = use_extension("//tools:browsers.bzl", "browsers")
use_repo(browsers, "browser_chrome", "browser_chromedriver", "browser_firefox", "browser_geckodriver")

host_environment = use_repo_rule("//tools:host-env.bzl", "host_environment")
host_environment(name = "host_environment")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "20.1.8",
    # The locked FHS runtime has no host-distro identity to probe.
    exec_os = "linux",
    linker = {"linux-x86_64": "/usr/bin/mold", "linux-aarch64": "/usr/bin/mold"},
)
llvm.extra_compiler_files(name = "llvm_toolchain", label = "@host_environment//:identity")
llvm.extra_linker_files(name = "llvm_toolchain", label = "@host_environment//:identity")
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")
register_toolchains("@llvm_toolchain//:all")

tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
tools.cmake(version = "3.31.12", mode = "binary")
tools.ninja(version = "1.13.2", mode = "binary")
use_repo(tools, "rules_foreign_cc_toolchains")

# utoipa-swagger-ui 9.0.2's default asset, fetched before sandboxed actions.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "swagger_ui_assets",
    urls = ["https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.17.14.zip"],
    sha256 = "481244d0812097b11fbaeef79f71d942b171617f9c9f9514e63acbe13e71ccdc",
    downloaded_file_path = "swagger-ui.zip",
)

include("//tools:rust-pins.MODULE.bazel")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless",
    image = "gcr.io/distroless/cc-debian13",
    digest = "sha256:1ca671d851d5cd39326d095b949a1d4e6ec836f59c5022b21efcd2773bd3a6d5",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless", "distroless_linux_amd64")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "wasm32-unknown-unknown"],
    skip_cargo_lockfile_overwrite = True,
    host_tools = "@pulsebeam_rust_host_tools//:BUILD.bazel",
)
CMAKE_TOOLCHAINS = ["@rules_foreign_cc//toolchains:current_cmake_toolchain", "@rules_foreign_cc//toolchains:current_ninja_toolchain"]
CMAKE_TOOLS = ["@pulsebeam//tools:cmake.sh"]
CMAKE_ENV = {
    "CMAKE": "$(execpath @pulsebeam//tools:cmake.sh)",
    "CMAKE_GENERATOR": "Ninja",
    "PULSEBEAM_CMAKE": "$${pwd}/$(CMAKE)",
    "PULSEBEAM_NINJA": "$${pwd}/$(REAL_NINJA)",
}
CMAKE_INJECTIONS = {"//tools:cmake.sh": "@pulsebeam"}
crate.annotation(crate = "aws-lc-sys", build_script_tools = CMAKE_TOOLS, build_script_toolchains = CMAKE_TOOLCHAINS, build_script_env = CMAKE_ENV, label_injections = CMAKE_INJECTIONS, repositories = ["crates", "str0m_native", "str0m_rtc", "str0m_reference"])
crate.annotation(crate = "opusic-sys", build_script_tools = CMAKE_TOOLS, build_script_toolchains = CMAKE_TOOLCHAINS, build_script_env = CMAKE_ENV, label_injections = CMAKE_INJECTIONS, repositories = ["crates"])
crate.annotation(
    crate = "openh264-sys2",
    repositories = ["crates"],
    label_injections = {"@nasm//:nasm": "@nasm"},
    build_script_tools = ["@nasm//:nasm"],
    build_script_env = {"NASM": "$(execpath @nasm//:nasm)"},
)
# Cargo's custom tokio_unstable cfg is applied by .bazelrc, but crate-universe
# does not include cfg-gated edges in its generated platform selects.
crate.annotation(crate = "tokio", deps = ["@crates//tracing"], repositories = ["crates"])
# Upstream emits an absolute build-script sandbox path into its RustEmbed derive.
# Resolve OUT_DIR during compilation using rust-embed's maintained interpolation.
crate.annotation(
    crate = "utoipa-swagger-ui",
    repositories = ["crates"],
    patches = ["//tools:patches/swagger-ui-relocatable-embed.patch"],
    patch_args = ["-p1"],
    build_script_data = ["@swagger_ui_assets//file"],
    build_script_env = {"SWAGGER_UI_DOWNLOAD_URL": "file://$(execpath @swagger_ui_assets//file)"},
    label_injections = {"@swagger_ui_assets//file": "@swagger_ui_assets"},
)
use_repo(crate, "crates")
