load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_shared_library", "rust_static_library", "rust_library", "rust_test", "rust_clippy_test", "rustfmt_test")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")

package(default_visibility = ["//visibility:public"])
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "*.json", "*.yaml", "scripts/*.sh"], allow_empty = True))
exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = glob(["Cargo.toml", "uniffi.toml", "src/**/*.rs", "benches/**/*.rs", "examples/**/*.rs"], allow_empty = True))

cargo_toml_env_vars(name = "cargo_env", src = "Cargo.toml", workspace = "//:Cargo.toml")
extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

rust_library(
    name = "pulsebeam-agent-native",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = ["Cargo.toml", "//:Cargo.toml"] + glob(["README.md", "src/**"], exclude = ["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = [],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases() | {"//agents/pulsebeam-agent-core:pulsebeam-agent-core": "agent_core"},
    deps = all_crate_deps(normal = True) + ["//agents/pulsebeam-agent-core:pulsebeam-agent-core", "//crates/pulsebeam-core:pulsebeam-core", "//crates/pulsebeam-proto:pulsebeam-proto"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_library(
    name = "pulsebeam-agent-native-sim",
    crate_name = "pulsebeam_agent_native",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = ["Cargo.toml", "//:Cargo.toml"] + glob(["README.md", "src/**"], exclude = ["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = ["sim"],
    rustc_flags = ["-Copt-level=2", "-Cdebug-assertions=yes", "-Coverflow-checks=yes"],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases() | {"//agents/pulsebeam-agent-core:pulsebeam-agent-core": "agent_core"},
    deps = all_crate_deps(normal = True) + ["//agents/pulsebeam-agent-core:pulsebeam-agent-core", "//crates/pulsebeam-core:pulsebeam-core-sim", "//crates/pulsebeam-proto:pulsebeam-proto"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    crate = ":pulsebeam-agent-native",
    lint_config = ":lints",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + ["//crates/pulsebeam-testdata:pulsebeam-testdata"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    
)

rust_shared_library(
    name = "native_library",
    rustc_flags = ["-Cpanic=abort"],
    crate_name = "pulsebeam_agent_native",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = ["Cargo.toml", "//:Cargo.toml"],
    edition = crate_edition(),
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases() | {"//agents/pulsebeam-agent-core:pulsebeam-agent-core": "agent_core"},
    deps = all_crate_deps(normal = True) + ["//agents/pulsebeam-agent-core", "//crates/pulsebeam-core", "//crates/pulsebeam-proto"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_static_library(
    name = "native_static",
    crate_name = "pulsebeam_agent_native",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = ["Cargo.toml", "//:Cargo.toml"],
    edition = crate_edition(),
    rustc_flags = ["-Cpanic=abort"],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases() | {"//agents/pulsebeam-agent-core:pulsebeam-agent-core": "agent_core"},
    deps = all_crate_deps(normal = True) + ["//agents/pulsebeam-agent-core", "//crates/pulsebeam-core", "//crates/pulsebeam-proto"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

filegroup(name = "native", srcs = [":native_library", ":native_static", ":bindings"])

rust_binary(
    name = "bindgen",
    crate_root = "src/bin/bindgen.rs",
    srcs = ["src/bin/bindgen.rs"],
    crate_features = ["bindgen"],
    edition = crate_edition(),
    deps = ["@build_tools//:uniffi"],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
)

run_binary(
    name = "bindings",
    tool = "//tools:native-codegen",
    srcs = [":native_library", "//:cargo_metadata_inputs"],
    tools = [":bindgen", "@pulsebeam_rust_host_tools//:cargo", "@pulsebeam_rust_host_tools//:rustc", "@pulsebeam_rust_host_tools//:rustc_lib"],
    out_dirs = ["generated-bindings"],
    args = [
        "--generator", "$(execpath :bindgen)",
        "--cargo", "$(execpath @pulsebeam_rust_host_tools//:cargo)",
        "--rustc", "$(execpath @pulsebeam_rust_host_tools//:rustc)",
        "--library", "$(execpath :native_library)",
        "--output", "$(RULEDIR)/generated-bindings",
    ],
    mnemonic = "UniFFIBindings",
)

rustfmt_test(name = "format", targets = [":pulsebeam-agent-native"])
rust_clippy_test(name = "clippy", targets = [":pulsebeam-agent-native", ":unit_tests"])
