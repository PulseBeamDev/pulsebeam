load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test", "js_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@react_npm//:defs.bzl", "npm_link_all_packages")
load("@react_npm//agents/react:typescript/package_json.bzl", typescript = "bin")
load("@react_npm//agents/react:prettier/package_json.bzl", prettier = "bin")

package(default_visibility = ["//visibility:public"])
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "*.json", "*.yaml", "scripts/*.sh"], allow_empty = True))
exports_files(["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"])

npm_link_all_packages(name = "node_modules")
typescript.tsc_binary(name = "tsc")

js_library(name = "component_support", srcs = glob(["tests/component/**"]))
js_library(name = "component_sources", srcs = glob(["src/**"]))

js_test(
    name = "component_tests",
    entry_point = "tests/component/run.mjs",
    args = ["tests/component/lifecycle.tsx"],
    chdir = package_name(),
    data = [
        ":component_support", ":component_sources", "package.json",
        ":node_modules/react", ":node_modules/react-dom",
        ":node_modules/happy-dom", ":node_modules/esbuild",
        "//agents/pulsebeam-agent-web:component_sources",
    ],
)


# Package/type gates check the public SDK types. This target emits only the
# pure decision module, without assembling the SDK for a type-only import.
js_run_binary(
    name = "unit_javascript",
    tool = ":tsc",
    srcs = ["src/session-key.ts"],
    args = ["--noCheck", "--noResolve", "--target", "ES2022", "--module", "ESNext", "--rootDir", "src", "--outDir", "unit-javascript", "src/session-key.ts"],
    chdir = package_name(),
    out_dirs = ["unit-javascript"],
)

js_test(
    name = "unit_tests",
    entry_point = "tests/session-key.mjs",
    data = [":unit_javascript", "package.json"],
)
prettier.prettier_binary(name = "prettier")

js_binary(
    name = "packed_consumer",
    entry_point = "tests/packed-consumer.mjs",
    data = [":node_modules"],
)

py_test(
    name = "packed_contract",
    srcs = ["tests/install.py"],
    main = "tests/install.py",
    args = [
        "$(rootpath :package.pack)",
        "$(rootpath //agents/pulsebeam-agent-web:package.pack)",
        "$(rootpath :packed_consumer)",
        "$(rootpath :node_modules/react/dir)",
        "$(rootpath :node_modules/@types/react/dir)",
        "$(rootpath //agents/pulsebeam-agent-web:node_modules/@ubjs/core/dir)",
        "$(rootpath //agents/react/tests/consumer:sources)",
    ],
    data = [
        ":package.pack", "//agents/pulsebeam-agent-web:package.pack", ":packed_consumer",
        ":node_modules/react/dir", ":node_modules/@types/react/dir",
        "//agents/pulsebeam-agent-web:node_modules/@ubjs/core/dir",
        "//agents/react/tests/consumer:sources",
    ],
)

js_run_binary(
    name = "typescript",
    tool = ":tsc",
    srcs = ["tsconfig.json", ":node_modules"] + glob(["src/**"]),
    args = ["-p", "tsconfig.json", "--outDir", "typescript"],
    chdir = package_name(),
    out_dirs = ["typescript"],
)

npm_package(
    name = "package",
    srcs = ["package.json", "README.md", "LICENSE", ":typescript"],
    data = [":node_modules"],
    replace_prefixes = {"typescript": "dist"},
    packable = True,
)

typescript.tsc_test(
    name = "contracts",
    args = ["-p", "tsconfig.contracts.json"],
    chdir = package_name(),
    data = [":node_modules"] + glob(["src/**", "tests/contracts/**", "tsconfig*.json"]),
)

copy_to_directory(
    name = "format_sources",
    srcs = glob(["src/**", "tests/component/**", "tests/contracts/**", "tests/*.mjs", "*.json"]) + ["//agents/react/tests/consumer:sources", "//docs:react_example"],
)

py_test(
    name = "format",
    srcs = ["//tools:check-js-format.py"],
    main = "//tools:check-js-format.py",
    args = ["--formatter", "$(rootpath :prettier)", "--source", "$(rootpath :format_sources)", "--", "src/**/*.ts", "tests/component/**/*.{mjs,ts,tsx}", "docs/react/*.tsx", "tests/contracts/**/*.ts", "tests/consumer/src/**/*.ts", "tests/*.mjs", "*.json"],
    data = [":prettier", ":format_sources"],
)

copy_to_directory(
    name = "quickstart_source",
    srcs = ["//docs:react_example"],
    root_paths = ["docs/react"],
)

typescript.tsc_test(
    name = "quickstart_types",
    args = ["-p", "tsconfig.quickstart.json"],
    chdir = package_name(),
    data = [":quickstart_source", ":package", ":node_modules", "//agents/pulsebeam-agent-web:package", "tsconfig.quickstart.json"],
)

js_binary(
    name = "quickstart_builder",
    entry_point = "tests/build-quickstart.mjs",
    data = [":node_modules"],
)

js_run_binary(
    name = "quickstart",
    tool = ":quickstart_builder",
    srcs = [":quickstart_source", ":package", ":node_modules", "//agents/pulsebeam-agent-web:package"],
    args = ["quickstart"],
    chdir = package_name(),
    out_dirs = ["quickstart"],
)

py_binary(
    name = "quickstart_dev",
    srcs = ["//tools:static-server.py"],
    main = "//tools:static-server.py",
    args = ["$(rootpath :quickstart)"],
    data = [":quickstart"],
)

build_test(name = "quickstart_build", targets = [":quickstart"])

test_suite(
    name = "fast",
    tests = [":unit_tests", ":component_tests", ":contracts", ":packed_contract", ":quickstart_types", ":quickstart_build", "//agents/react/tests/consumer:contract"],
)
