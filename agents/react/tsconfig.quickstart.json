{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "paths": {
      "@pulsebeam/react": ["./package/dist/index.d.ts"],
      "@pulsebeam/web": ["../pulsebeam-agent-web/package/dist/index.d.ts"]
    }
  },
  "include": ["quickstart_source/*.tsx"]
}
