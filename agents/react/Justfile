set shell := ["bash", "-euc"]

# Build the React adapter and its declarations.
build: prepare
    just --justfile ../pulsebeam-agent-web/Justfile build
    pnpm run build

# The React package owns preparation of its direct web dependency.
prepare:
    just --justfile ../pulsebeam-agent-web/Justfile prepare
    pnpm install --frozen-lockfile --ignore-scripts

# Format package and browser-contract sources.
fix: prepare
    pnpm run format

format-check: prepare
    pnpm run format:check

# Check the implementation and public type contract.
check: format-check
    just --justfile ../pulsebeam-agent-web/Justfile build
    pnpm run check

# Run React compile and package-resolution checks only.
test: build
    pnpm run test

# Build the standalone, Rust-driven browser fixture.
browser-fixture: build
    pnpm run build:browser

# Build a React-only consumer after preparing the local runtime and its assets.
consumer: build
    pnpm run test:consumer
