load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = ["Cargo.toml"] + glob(["src/**/*.rs"]))
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "*.json", "*.yaml", "scripts/*.sh"], allow_empty = True))

extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

# Optional Cargo executor dependencies are declared explicitly on its Bazel target.
_TRANSPORT_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "pulsebeam-agent-quic",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    lint_config = ":lints",
    aliases = aliases(),
    deps = _TRANSPORT_DEPS + [
        "//crates/pulsebeam-core",
        "//crates/pulsebeam-proto:pulsebeam-proto-json",
        "//crates/pulsebeam-udp:pulsebeam-udp",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

rust_library(
    name = "pulsebeam-agent-quic-sim",
    crate_name = "pulsebeam_agent_quic",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = ["sim"],
    lint_config = ":lints",
    aliases = aliases(),
    deps = _TRANSPORT_DEPS + [
        "//crates/pulsebeam-core:pulsebeam-core-sim",
        "//crates/pulsebeam-proto:pulsebeam-proto-json",
        "//crates/pulsebeam-udp:pulsebeam-udp-sim",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

[rust_library(
    name = "executor" + ("-sim" if sim else ""),
    crate_name = "pulsebeam_agent_quic",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = ["executor"] + (["sim"] if sim else []),
    lint_config = ":lints",
    aliases = aliases(),
    deps = _TRANSPORT_DEPS + [
        "@crates//:reqwest",
        "@crates//:tokio",
        "//agents/pulsebeam-agent-core:pulsebeam-agent-core" + ("-sim" if sim else ""),
        "//crates/pulsebeam-core:pulsebeam-core-http" + ("-sim" if sim else ""),
        "//crates/pulsebeam-proto:pulsebeam-proto",
        "//crates/pulsebeam-runtime:pulsebeam-runtime" + ("-sim" if sim else ""),
        "//crates/pulsebeam-udp:pulsebeam-udp" + ("-sim" if sim else ""),
    ],
    target_compatible_with = ["@platforms//os:linux"],
) for sim in [False, True]]

rust_test(
    name = "unit_tests",
    crate = ":executor",
    crate_features = ["executor"],
    aliases = aliases(normal = True, normal_dev = True),
    deps = all_crate_deps(normal_dev = True),
    target_compatible_with = ["@platforms//os:linux"],
)

rust_clippy_test(name = "clippy", targets = [":pulsebeam-agent-quic", ":executor", ":executor-sim", ":unit_tests"])
rustfmt_test(name = "format", targets = [":pulsebeam-agent-quic", ":executor", ":unit_tests"])
