load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = ["Cargo.toml"] + glob(["src/**/*.rs"]))

extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

rust_library(
    name = "pulsebeam-agent-quic",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    lint_config = ":lints",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/pulsebeam-proto:pulsebeam-proto",
        "//crates/pulsebeam-udp:pulsebeam-udp",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

rust_test(
    name = "unit_tests",
    crate = ":pulsebeam-agent-quic",
    aliases = aliases(normal = True, normal_dev = True),
    deps = all_crate_deps(normal_dev = True),
    target_compatible_with = ["@platforms//os:linux"],
)

rust_clippy_test(name = "clippy", targets = [":pulsebeam-agent-quic", ":unit_tests"])
rustfmt_test(name = "format", targets = [":pulsebeam-agent-quic", ":unit_tests"])
