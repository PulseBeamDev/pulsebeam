set shell := ["bash", "-euc"]
set tempdir := "/tmp"

# Build the private WASM artifact and public TypeScript package.
build:
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm run build

# The web package owns its lockfile and install.
prepare:
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm install --frozen-lockfile --ignore-scripts

# Regenerate the UniFFI web proof and its WASM package.
uniffi-generate:
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm run build:uniffi
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm exec prettier --write "generated/**/*.ts"

# Transpile generated bindings for the Rust-authored browser proof.
uniffi-browser-build: uniffi-generate
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm exec tsc -p tsconfig.uniffi.browser.json
    mkdir -p dist/uniffi-proof/generated/bindings/wasm-bindgen
    cp generated/bindings/wasm-bindgen/index_bg.wasm dist/uniffi-proof/generated/bindings/wasm-bindgen/index_bg.wasm

# Regenerate and reject checked-in binding drift.
uniffi-check: uniffi-generate
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm exec tsc -p tsconfig.uniffi.json
    cargo test -p pulsebeam-agent-web --test uniffi_contract
    git diff --exit-code -- generated

# Check Rust/WASM and the handwritten TypeScript boundary.
check:
    cargo check -p pulsebeam-agent-web --target wasm32-unknown-unknown
    PNPM_HOME=/tmp/pulsebeam-pnpm-home PNPM_STORE_DIR=/tmp/pulsebeam-pnpm-store XDG_CACHE_HOME=/tmp/pulsebeam-pnpm-cache XDG_CONFIG_HOME=/tmp/pulsebeam-pnpm-config pnpm run check

# Run browser-runtime unit and deterministic host-boundary tests.
test: build uniffi-browser-build
    cargo test -p pulsebeam-agent-web
    cargo test -p pulsebeam-agent-web --features browser-tests --test browser

# Serve the generated package and local example.
serve:
    python3 -m http.server 4173 --bind 127.0.0.1
