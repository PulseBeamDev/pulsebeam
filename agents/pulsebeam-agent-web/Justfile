set shell := ["bash", "-euc"]

# Build the private WASM artifact and public TypeScript package.
build: prepare
    pnpm run build

# The web package owns its lockfile and install. UBRN 0.31.0-5 hard-pins an
# in-process wasm-bindgen schema; align that installed source with this package
# until upstream #454 is released.
prepare:
    pnpm install --frozen-lockfile --ignore-scripts
    grep -Eq '^wasm-bindgen-cli-support = "=(0\.2\.100|0\.2\.127)"$' node_modules/uniffi-bindgen-react-native/Cargo.toml
    sed -i 's/^wasm-bindgen-cli-support = "=0\.2\.100"$/wasm-bindgen-cli-support = "=0.2.127"/' node_modules/uniffi-bindgen-react-native/Cargo.toml
    grep -qx 'wasm-bindgen-cli-support = "=0.2.127"' node_modules/uniffi-bindgen-react-native/Cargo.toml
    grep -Eq '^wasm-bindgen = "(\*|=0\.2\.127)"$' node_modules/uniffi-bindgen-react-native/crates/ubrn_cli/templates/wasm/Cargo.toml.txt
    sed -i 's/^wasm-bindgen = "\*"$/wasm-bindgen = "=0.2.127"/' node_modules/uniffi-bindgen-react-native/crates/ubrn_cli/templates/wasm/Cargo.toml.txt
    grep -qx 'wasm-bindgen = "=0.2.127"' node_modules/uniffi-bindgen-react-native/crates/ubrn_cli/templates/wasm/Cargo.toml.txt

# Format handwritten TypeScript and JavaScript sources.
fix: prepare
    pnpm run format

format-check: prepare
    pnpm run format:check

# Regenerate the UniFFI web proof and its WASM package.
uniffi-generate:
    pnpm run build:uniffi
    pnpm exec prettier --write "generated/**/*.ts"

# Transpile generated bindings for the Rust-authored browser proof.
uniffi-browser-build: uniffi-generate
    pnpm exec tsc -p tsconfig.uniffi.browser.json
    mkdir -p dist/uniffi-proof/generated/bindings/wasm-bindgen
    cp generated/bindings/wasm-bindgen/index_bg.wasm dist/uniffi-proof/generated/bindings/wasm-bindgen/index_bg.wasm

# Regenerate and reject checked-in binding drift.
uniffi-check: uniffi-generate
    pnpm exec tsc -p tsconfig.uniffi.json
    cargo test -p pulsebeam-agent-web --test uniffi_contract
    git diff --exit-code -- generated

# Check Rust/WASM and the handwritten TypeScript boundary.
check: format-check
    cargo check -p pulsebeam-agent-web --target wasm32-unknown-unknown
    pnpm run build:wasm
    pnpm run check

# Run deterministic host-boundary unit tests. Generated binding contracts have their own gate.
test-fast: build uniffi-browser-build
    cargo test -p pulsebeam-agent-web --lib

# Run browser contracts after rebuilding every Web and React fixture.
test-slow:
    ../../crates/pulsebeam-rtc/scripts/provision-browsers.sh --platform linux-x86_64 --verify-only
    just browser-fixture
    just --justfile ../react/Justfile browser-fixture
    PULSEBEAM_BROWSER_BINARY="{{ justfile_directory() }}/../../target/pulsebeam-rtc-browsers/linux-x86_64/bin/chrome" just browser-run

# Build every Web-owned browser artifact without running Chrome.
browser-fixture: build uniffi-browser-build

browser: browser-fixture
    cargo test -p pulsebeam-agent-web --features browser-tests --test browser -- --test-threads=1

# Run already-built browser artifacts. Root orchestration uses this after the
# React fixture records the final Web package build.
browser-run:
    cargo test -p pulsebeam-agent-web --features browser-tests --test browser -- --test-threads=1

# Serve the generated package and local example.
dev: build
    python3 -m http.server 4173 --bind 127.0.0.1
