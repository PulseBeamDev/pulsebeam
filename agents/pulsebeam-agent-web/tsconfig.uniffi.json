{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true
  },
  "include": ["generated/**/*.ts", "web/media-registry.ts", "web/assets.d.ts"]
}
