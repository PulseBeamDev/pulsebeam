{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "verbatimModuleSyntax": true
  },
  "include": [
    "index.ts",
    "internal/react.ts",
    "generated/bindings/**/*.ts",
    "web/media-registry.ts",
    "web/wasm-bytes.d.ts"
  ]
}
