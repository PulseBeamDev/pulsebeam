{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "web",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["web/**/*.ts"]
}
