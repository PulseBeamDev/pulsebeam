    "format": "../../bazel run //agents/pulsebeam-agent-web:fix",
    "test": "../../bazel test //agents/pulsebeam-agent-web:unit_tests //agents/pulsebeam-agent-web:browser"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-language-server": "5.1.3"
  }
