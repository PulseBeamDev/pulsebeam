  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PulseBeamDev/pulsebeam.git"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.wasm"
  ],
