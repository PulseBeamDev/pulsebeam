set shell := ["bash", "-euc"]

dev: prepare
    just --justfile ../../agents/react/Justfile build
    pnpm run dev

build: prepare
    just --justfile ../../agents/react/Justfile build
    pnpm run build

fix: prepare
    pnpm run format

format-check: prepare
    pnpm run format:check

check: format-check
    just --justfile ../../agents/react/Justfile build
    pnpm run check

test-fast:
    @:

# Run the real static app using the shared Web browser driver and owned server.
test-slow: build
    cd ../.. && cargo test -p pulsebeam-agent-web --features browser-tests --test meet meet_leave_releases_capture_and_transport -- --test-threads=1

# Install only after the direct React dependency has prepared its owned assets.
prepare:
    just --justfile ../../agents/react/Justfile prepare
    pnpm install --frozen-lockfile --ignore-scripts
