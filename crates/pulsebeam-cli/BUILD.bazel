load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "scripts/*.sh"], allow_empty = True))
exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = glob(["Cargo.toml", "uniffi.toml", "src/**/*.rs", "benches/**/*.rs", "examples/**/*.rs"], allow_empty = True))
cargo_toml_env_vars(name = "cargo_env", src = "Cargo.toml", workspace = "//:Cargo.toml")
extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

rust_binary(
    name = "pulsebeam-cli",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = crate_edition(),
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//agents/pulsebeam-agent-native",
        "//crates/pulsebeam-core:pulsebeam-core-http",
        "//crates/pulsebeam-proto",
        "//crates/pulsebeam-testdata",
        "//server/rust:pulsebeam-server",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(name = "unit_tests", crate = ":pulsebeam-cli", lint_config = ":lints")

py_binary(
    name = "native_foreign_smoke",
    testonly = True,
    srcs = ["tests/native_foreign_smoke.py"],
    main = "tests/native_foreign_smoke.py",
)

rust_test(
    name = "production_native",
    crate_root = "tests/production_native.rs",
    srcs = ["tests/production_native.rs", "//agents/pulsebeam-agent-web:destination_test_support"],
    data = [":native_foreign_smoke", "//agents/pulsebeam-agent-native:bindings", "//agents/pulsebeam-agent-native:native_library"],
    env = {
        "PULSEBEAM_FOREIGN_SMOKE": "$(rootpath :native_foreign_smoke)",
        "PULSEBEAM_NATIVE_BINDINGS": "$(rootpath //agents/pulsebeam-agent-native:bindings)",
        "PULSEBEAM_NATIVE_LIBRARY": "$(rootpath //agents/pulsebeam-agent-native:native_library)",
    },
    edition = crate_edition(),
    lint_config = ":lints",
    aliases = aliases(normal = True, normal_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//agents/pulsebeam-agent-native",
        "//crates/pulsebeam:pulsebeam",
        "//crates/pulsebeam-core:pulsebeam-core",
        "//crates/pulsebeam-runtime:pulsebeam-runtime",
        "//server/rust:pulsebeam-server",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    size = "medium",
    tags = ["cpu:2"],
)

rustfmt_test(name = "format", targets = [":pulsebeam-cli", ":production_native"])
rust_clippy_test(name = "clippy", targets = [":pulsebeam-cli", ":unit_tests", ":production_native"])
