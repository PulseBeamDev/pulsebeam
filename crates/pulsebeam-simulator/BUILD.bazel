load("//tools:calibration.bzl", "VARIANTS")
load("//tools:simulation-provenance.bzl", "simulation_provenance")
load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")

package(default_visibility = ["//visibility:public"])
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "scripts/*.sh"], allow_empty = True))
exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = glob(["Cargo.toml", "uniffi.toml", "src/**/*.rs", "benches/**/*.rs", "examples/**/*.rs"], allow_empty = True))
cargo_toml_env_vars(name = "cargo_env", src = "Cargo.toml", workspace = "//:Cargo.toml")
extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

# Compile the same external services module independently while migrating the
# fixture consumers. This does not qualify the integrated SFU scenario.
rust_library(
    name = "native_runtime_services",
    testonly = True,
    crate_root = "src/tests/common/native.rs",
    srcs = ["src/tests/common/native.rs"],
    edition = crate_edition(),
    lint_config = ":lints",
    deps = [
        "@crates//:anyhow",
        "@crates//:tokio",
        "@crates//:tokio-util",
        "@crates//:turmoil",
        "//crates/pulsebeam-core:pulsebeam-core-sim",
        "//crates/pulsebeam-rtc/simulation:pulsebeam-rtc-simulation",
        "//agents/pulsebeam-agent-native:pulsebeam-agent-native-sim",
    ],
)

[rust_test(
    name = "test_binary" if variant == "control" else "test_binary_" + variant,
    crate_name = "pulsebeam_simulator",
    crate_root = "src/main.rs",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "src/tests/histories/admission-replacement.history",
        "src/tests/properties.regressions",
    ],
    edition = crate_edition(),
    crate_features = ["parking_lot"],
    lint_config = ":lints",
    rustc_env_files = [":cargo_env"],
    rustc_flags = ["-Copt-level=2", "-Cdebug-assertions=yes", "-Coverflow-checks=yes"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True) | {
        ("//crates/pulsebeam:pulsebeam-sim" if variant == "control" else "//crates/pulsebeam:pulsebeam-sim-" + variant): "pulsebeam",
    },
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/pulsebeam:pulsebeam-sim" if variant == "control" else "//crates/pulsebeam:pulsebeam-sim-" + variant,
        "//crates/pulsebeam-core:pulsebeam-core-sim",
        "//crates/pulsebeam-runtime:pulsebeam-runtime-sim",
        "//crates/pulsebeam-testdata",
        "//crates/pulsebeam-rtc/simulation:pulsebeam-rtc-simulation",
        "//server/rust:pulsebeam-server",
        "//agents/pulsebeam-agent-core:pulsebeam-agent-core-sim",
        "//agents/pulsebeam-agent-native:pulsebeam-agent-native-sim",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    tags = ["manual"],
) for variant in ["control"] + VARIANTS]

# Target-local rustc_flags do not optimize dependencies. Apply the simulation
# profile to the complete dependency closure without changing other owners.
platform(
    name = "sim_platform",
    parents = ["@platforms//host"],
    flags = [
        "--compilation_mode=opt",
        "--@rules_rust//rust/settings:codegen_units=256",
        "--@rules_rust//rust/settings:per_crate_rustc_flag=@-Copt-level=2",
        "--@rules_rust//rust/settings:per_crate_rustc_flag=@-Cdebug-assertions=yes",
        "--@rules_rust//rust/settings:per_crate_rustc_flag=@-Coverflow-checks=yes",
        "--@rules_rust//rust/settings:per_crate_rustc_flag=@-Cdebuginfo=1",
        "--@rules_rust//rust/settings:per_crate_rustc_flag=@-Cstrip=none",
    ],
)

[platform_transition_filegroup(
    name = "sim_binary" if variant == "control" else "sim_binary_" + variant,
    testonly = True,
    srcs = [":test_binary" if variant == "control" else ":test_binary_" + variant],
    target_platform = ":sim_platform",
    tags = ["manual"],
) for variant in ["control"] + VARIANTS]

# Reserve one CPU per isolated child, from the same budget used by the runner.
SIMULATION_JOBS = 4

simulation_provenance(name = "candidate")

CANDIDATE_ARGS = ["--candidate", "$(rootpath :candidate)"]

py_test(
    name = "fast",
    srcs = ["//tools:run-simulations.py"],
    main = "//tools:run-simulations.py",
    args = ["$(rootpath :sim_binary)", "--mode", "fast", "--jobs", str(SIMULATION_JOBS)] + CANDIDATE_ARGS,
    data = [":sim_binary", ":candidate"],
    size = "large",
    tags = ["cpu:%s" % SIMULATION_JOBS],
)

py_test(
    name = "slow",
    srcs = ["//tools:run-simulations.py"],
    main = "//tools:run-simulations.py",
    args = ["$(rootpath :sim_binary)", "--mode", "slow", "--jobs", str(SIMULATION_JOBS)] + CANDIDATE_ARGS,
    data = [":sim_binary", ":candidate"],
    size = "enormous",
    tags = ["slow", "cpu:%s" % SIMULATION_JOBS],
)

REPLAY_ARGS = ["$(rootpath :sim_binary)", "--mode", "all"] + CANDIDATE_ARGS

py_binary(
    name = "replay",
    testonly = True,
    srcs = ["//tools:run-simulations.py"],
    main = "//tools:run-simulations.py",
    args = REPLAY_ARGS,
    data = [":sim_binary", ":candidate"],
)

py_binary(
    name = "sweep",
    testonly = True,
    srcs = ["//tools:run-simulations.py"],
    main = "//tools:run-simulations.py",
    args = ["$(rootpath :sim_binary)", "--mode", "all", "--seeds", "20", "--from-seed", "1"] + CANDIDATE_ARGS,
    data = [":sim_binary", ":candidate"],
)

py_binary(
    name = "scoreboard",
    testonly = True,
    srcs = ["//tools:scoreboard.py"],
    main = "//tools:scoreboard.py",
    # Keep each plan's metrics adjacent to its result for deterministic grouping.
    args = ["--runner", "$(rootpath :replay)", "--parser", "$(rootpath //tools:scoreboard_parser)"] + [
        "--runner-arg=" + arg for arg in REPLAY_ARGS + ["--jobs", "1", "--show-output"]
    ],
    data = [":replay", ":sim_binary", ":candidate", "//tools:scoreboard_parser"],
)

CALIBRATION_DATA = [":candidate", ":sim_binary"] + [":sim_binary_" + variant for variant in VARIANTS] + [
    "//crates/pulsebeam:calibration-" + variant + "-provenance" for variant in VARIANTS
]

CALIBRATION_ARGS = CANDIDATE_ARGS + ["--control", "$(rootpath :sim_binary)"] + [
    arg
    for variant in VARIANTS
    for arg in ["--variant", variant, "$(rootpath :sim_binary_" + variant + ")", "$(rootpath //crates/pulsebeam:calibration-" + variant + "-provenance)"]
]

py_test(
    name = "calibration",
    srcs = ["//tools:calibrate.py", "//tools:run-simulations.py"],
    main = "//tools:calibrate.py",
    args = CALIBRATION_ARGS,
    data = CALIBRATION_DATA,
    size = "large",
    tags = ["manual", "cpu:1"],
)

py_binary(
    name = "calibration_replay",
    testonly = True,
    srcs = ["//tools:calibrate.py", "//tools:run-simulations.py"],
    main = "//tools:calibrate.py",
    args = CALIBRATION_ARGS,
    data = CALIBRATION_DATA,
    tags = ["manual"],
)

rustfmt_test(name = "format", targets = [":test_binary"])
rust_clippy_test(name = "clippy", targets = [":test_binary"])
