# PulseBeam packages GN native outputs for a Rust linker, without GN Rust rlibs.
# Restrict the extra visibility to those two native-only packaging targets.
diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -523,6 +523,7 @@ if (!build_with_chromium) {
     visibility = [
       "//:default",
       "//:webrtc_lib_link_test",
+      "//pulsebeam:pulsebeam",
     ]
 
     sources = []
diff --git a/buildtools/third_party/libc++/BUILD.gn b/buildtools/third_party/libc++/BUILD.gn
--- a/buildtools/third_party/libc++/BUILD.gn
+++ b/buildtools/third_party/libc++/BUILD.gn
@@ -399,6 +399,7 @@ target(libcxx_target_type, "libc++") {
   visibility = [
     "//build/config:common_deps",
     "//third_party/catapult/devil",
+    "//pulsebeam:runtime",
   ]
   if (is_linux) {
     # This target packages libc++.so, so must have an explicit dependency on
diff --git a/buildtools/third_party/libc++abi/BUILD.gn b/buildtools/third_party/libc++abi/BUILD.gn
--- a/buildtools/third_party/libc++abi/BUILD.gn
+++ b/buildtools/third_party/libc++abi/BUILD.gn
@@ -12,6 +12,7 @@ target(libcxxabi_target_type, "libc++abi") {
   } else {
     visibility = [ "//buildtools/third_party/libc++" ]
   }
+  visibility += [ "//pulsebeam:runtime" ]
 
   # Fuchsia builds don't link against any libraries that provide stack
   # unwinding symbols, unlike Linux does with glibc (same applies for Android).
diff --git a/build/config/siso/nasm_linux.star b/build/config/siso/nasm_linux.star
--- a/build/config/siso/nasm_linux.star
+++ b/build/config/siso/nasm_linux.star
@@ -17,5 +17,6 @@
 def __step_config(ctx, step_config):
-    remote_run = config.get(ctx, "googlechrome")  # Turn this to False when you do file access trace.
+    # PulseBeam provides the interpreter and native toolchain on its Linux worker.
+    remote_run = True
     rules = []
     for toolchain in ["", "clang_x64"]:
         nasm_path = path.join(toolchain, "nasm")
diff --git a/build/toolchain/gcc_toolchain.gni b/build/toolchain/gcc_toolchain.gni
--- a/build/toolchain/gcc_toolchain.gni
+++ b/build/toolchain/gcc_toolchain.gni
@@ -17,2 +17,3 @@
 declare_args() {
