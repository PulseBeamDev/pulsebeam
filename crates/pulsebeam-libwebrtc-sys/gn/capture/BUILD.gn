import("//webrtc.gni")

rtc_executable("vp9_capture") {
  testonly = true
  sources = [ "vp9_capture.cc" ]
  deps = [
    "//api:rtp_header_extension_id",
    "//api:rtp_parameters",
    "//api:transport_api",
    "//api/environment:environment_factory",
    "//api/units:time_delta",
    "//api/units:timestamp",
    "//api/video:video_bitrate_allocation",
    "//api/video:video_frame",
    # The pinned libaom encoder calls Create but does not link its factory.
    "//api/video_codecs:encoder_speed_controller_factory",
    "//api/video_codecs:scalability_mode",
    "//api/video_codecs:video_codecs_api",
    "//call:rtp_interfaces",
    "//call:rtp_sender",
    "//modules/rtp_rtcp:rtp_rtcp",
    "//modules/rtp_rtcp:rtp_rtcp_format",
    "//modules/video_coding:video_codec_interface",
    "//modules/video_coding:video_coding",
    "//modules/video_coding:webrtc_h264",
    "//modules/video_coding:webrtc_vp8",
    "//modules/video_coding:webrtc_vp9",
    "//modules/video_coding/codecs/av1:libaom_av1_encoder",
    "//modules/video_coding/svc:scalability_mode_util",
    "//modules/video_coding/svc:scalability_structures",
    "//rtc_base:checks",
    "//rtc_base:logging",
    "//rtc_base:threading",
    "//system_wrappers",
    "//test/time_controller",
  ]
}

rtc_executable("codec_receive") {
  testonly = true
  sources = [ "codec_receive.cc" ]
  deps = [
    "//api:rtp_header_extension_id",
    "//api/video:rtp_video_frame_assembler",
    "//modules/rtp_rtcp:rtp_rtcp",
    "//modules/rtp_rtcp:rtp_rtcp_format",
    "//modules/video_coding:video_coding",
    "//rtc_base:checks",
  ]
}
