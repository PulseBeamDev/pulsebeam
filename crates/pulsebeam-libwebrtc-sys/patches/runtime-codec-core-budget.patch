diff --git a/rtc_base/openssl_stream_adapter.cc b/rtc_base/openssl_stream_adapter.cc
index a40c4ec6dc6bc76125db476a6ae1b7578d9005d7..45e866a4bd3d3865cc9ed67dc901e233c33dd449 100644
--- a/rtc_base/openssl_stream_adapter.cc
+++ b/rtc_base/openssl_stream_adapter.cc
@@ -52,6 +52,7 @@
 #include "rtc_base/string_encode.h"
 #include "rtc_base/synchronization/mutex.h"
 #include "rtc_base/task_utils/repeating_task.h"
+#include "rtc_base/time_utils.h"
 #include "system_wrappers/include/clock.h"
 
 #ifdef OPENSSL_IS_BORINGSSL
@@ -1167,6 +1168,14 @@ SSL_CTX* OpenSSLStreamAdapter::SetupSSLContext() {
     // Clock should be injected to set one for testing.
     RTC_CHECK(env_.has_value());
     clock_for_testing_.emplace(ctx, &env_->clock());
+  } else if (GetClockForTesting()) {
+    // Controlled execution must drive BoringSSL deadlines from the same native
+    // clock as delayed tasks. The callback's SSL argument may be null.
+    SSL_CTX_set_current_time_cb(ctx, +[](const SSL*, timeval* out_clock) {
+      const int64_t time_us = TimeMicros();
+      out_clock->tv_sec = time_us / TimeDelta::Seconds(1).us();
+      out_clock->tv_usec = time_us % TimeDelta::Seconds(1).us();
+    });
   }
   SSL_CTX_set0_buffer_pool(ctx, openssl::GetBufferPool());
 #endif
