+// Keep the original pthread path unless this particular native consumer selects
+// runtime injection. The persistent entry and per-frame barriers stay unchanged.
+typedef struct {
+  pthread_t native;
+  VPxWorker worker;
+  void *(*entry)(void *);
+  void *argument;
+  void *result;
+  int via_interface;
+} VP8WorkerThread;
+
+static INLINE int vp8_persistent_worker_hook(void *data1, void *data2) {
+  VP8WorkerThread *thread = (VP8WorkerThread *)data1;
+  (void)data2;
+  thread->result = thread->entry(thread->argument);
+  return 1;
+}
+
+static INLINE int vp8_thread_create(VP8WorkerThread *thread,
+                                   const pthread_attr_t *attributes,
+                                   void *(*entry)(void *), void *argument) {
+  const VPxRuntimeInterface *runtime = vpx_get_runtime_interface();
+  const VPxWorkerInterface *interface = vpx_get_worker_interface();
+  thread->via_interface = 0;
+  if (runtime->enabled == NULL || !runtime->enabled()) {
+    return pthread_create(&thread->native, attributes, entry, argument);
+  }
+  // VP8 supplies default attributes. Do not silently discard explicit ones.
+  if (attributes != NULL) return pthread_create(&thread->native, attributes,
+                                                entry, argument);
+  interface->init(&thread->worker);
+  thread->entry = entry;
+  thread->argument = argument;
+  thread->result = NULL;
+  thread->worker.hook = vp8_persistent_worker_hook;
+  thread->worker.data1 = thread;
+  if (!interface->reset(&thread->worker)) {
+    interface->end(&thread->worker);
+    return EAGAIN;
+  }
+  thread->via_interface = 1;
+  interface->launch(&thread->worker);
+  return 0;
+}
+
+static INLINE int vp8_thread_join(VP8WorkerThread *thread, void **result) {
+  if (!thread->via_interface) return pthread_join(thread->native, result);
+  // The caller first clears the original stop flag and wakes its start
+  // semaphore. Never sync this persistent hook at a per-frame barrier.
+  vpx_get_worker_interface()->end(&thread->worker);
+  if (result != NULL) *result = thread->result;
+  return 0;
+}
+#else
+#define VP8WorkerThread pthread_t
+#define vp8_thread_create pthread_create
+#define vp8_thread_join(thread, result) pthread_join(*(thread), result)
+#endif
