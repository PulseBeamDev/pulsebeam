   return &g_worker_interface;
 }
 
+static VPxRuntimeInterface g_runtime_interface;
+
+int vpx_set_runtime_interface(const VPxRuntimeInterface *runtime) {
+  if (runtime == NULL) {
+    memset(&g_runtime_interface, 0, sizeof(g_runtime_interface));
+    return 1;
+  }
+  if (runtime->enabled == NULL) return 0;
+  g_runtime_interface = *runtime;
+  return 1;
+}
+
+const VPxRuntimeInterface *vpx_get_runtime_interface(void) {
+  return &g_runtime_interface;
+}
+
