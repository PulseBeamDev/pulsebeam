diff --git a/vpx_util/vpx_thread.h b/vpx_util/vpx_thread.h
index 22051eae41edb2d2ee85287cb80886cd792f5e42..0d14010ec37b0ad1d68ab8fa3ddef5db35c5face 100644
--- a/vpx_util/vpx_thread.h
+++ b/vpx_util/vpx_thread.h
@@ -83,6 +83,33 @@ int vpx_set_worker_interface(const VPxWorkerInterface *const winterface);
 // Retrieve the currently set thread worker interface.
 const VPxWorkerInterface *vpx_get_worker_interface(void);
 
+// Optional runtime injection for VP8 persistent workers and untimed waits.
+// The thread adapter uses VPxWorkerInterface only when enabled() selects it.
+// A wait callback returns nonzero when it handled the operation and writes the
+// native return value to result. Otherwise the original platform primitive runs.
+// Only enabled is required; other callbacks may be NULL. If sem_init handles an
+// object, compatible wait/post/destroy callbacks must handle its full lifetime.
+// An unhandled callback must leave the object and errno unchanged.
+// Callbacks must preserve errno for native failures and must not advance time.
+// yield() is a runtime scheduling point inside the unchanged atomic predicate.
+// A null interface restores all original behavior. As with the worker interface,
+// installation is process-global, not thread-safe, and requires exclusive
+// acquisition before work plus retirement of all dependent workers before reset.
+typedef struct {
+  int (*enabled)(void);
+  int (*sem_init)(void *sem, int pshared, unsigned int value, int *result);
+  int (*sem_wait)(void *sem, int *result);
+  int (*sem_post)(void *sem, int *result);
+  int (*sem_destroy)(void *sem, int *result);
+  void (*yield)(void);
+  // Optional encoder resource input. Positive values replace the independently
+  // detected host processor count for the original VP8 worker-pool clamp only;
+  // zero/negative leaves native detection intact. Does not change g_threads.
+  int (*available_processors)(void);
+} VPxRuntimeInterface;
+int vpx_set_runtime_interface(const VPxRuntimeInterface *runtime);
+const VPxRuntimeInterface *vpx_get_runtime_interface(void);
+
 //------------------------------------------------------------------------------
 
 #ifdef __cplusplus
