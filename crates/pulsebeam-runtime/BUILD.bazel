load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_clippy_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])
filegroup(name = "workflow_inputs", srcs = glob(["*.md", "docs/**/*.md", "Justfile", "scripts/*.sh"], allow_empty = True))
exports_files(["Cargo.toml"])
filegroup(name = "cargo_metadata_inputs", srcs = glob(["Cargo.toml", "uniffi.toml", "src/**/*.rs", "benches/**/*.rs", "examples/**/*.rs"], allow_empty = True))

cargo_toml_env_vars(name = "cargo_env", src = "Cargo.toml", workspace = "//:Cargo.toml")
extract_cargo_lints(name = "lints", manifest = "Cargo.toml", workspace = "//:Cargo.toml")

rust_library(
    name = "pulsebeam-runtime",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = glob(["README.md", "src/**"], exclude = ["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = ["parking_lot"],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + ["//crates/pulsebeam-core:pulsebeam-core", "//crates/pulsebeam-routing:pulsebeam-routing"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_library(
    name = "pulsebeam-runtime-sim",
    crate_name = "pulsebeam_runtime",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**"]),
    compile_data = glob(["README.md", "src/**"], exclude = ["src/**/*.rs"]),
    edition = crate_edition(),
    crate_features = ["parking_lot", "sim"],
    rustc_flags = ["-Copt-level=2", "-Cdebug-assertions=yes", "-Coverflow-checks=yes"],
    rustc_env_files = [":cargo_env"],
    lint_config = ":lints",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + ["//crates/pulsebeam-core:pulsebeam-core-sim", "//crates/pulsebeam-routing:pulsebeam-routing"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    crate = ":pulsebeam-runtime",
    crate_features = ["parking_lot"],
    lint_config = ":lints",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    
)

rustfmt_test(name = "format", targets = [":pulsebeam-runtime"])
rust_clippy_test(name = "clippy", targets = [":pulsebeam-runtime", ":unit_tests"])
