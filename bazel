#!/usr/bin/env bash
set -euo pipefail
[[ $(uname -s) == Linux ]] || { echo 'PulseBeam requires a supported Linux host.' >&2; exit 1; }
case $(uname -m) in
  x86_64) arch=amd64; sha=e1508323f347ad1465a887bc5d2bfb91cffc232d11e8e997b623227c6b32fb76 ;;
  aarch64|arm64) arch=arm64; sha=bb608519a440d45d10304eb684a73a2b6bb7699c5b0e5434361661b25f113a5d ;;
  *) echo 'Development supports Linux x86_64; release-only builds also support Linux aarch64.' >&2; exit 1 ;;
esac
cache="${XDG_CACHE_HOME:-$HOME/.cache}/pulsebeam/bazelisk-1.27.0-$arch"
mkdir -p "$cache"
launcher="$cache/bazelisk"
if [[ ! -f "$launcher" ]]; then
  command -v curl >/dev/null || { echo 'Install curl and CA certificates to bootstrap Bazel.' >&2; exit 1; }
  tmp=$(mktemp "$cache/download.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  curl --fail --location --retry 3 "https://github.com/bazelbuild/bazelisk/releases/download/v1.27.0/bazelisk-linux-$arch" -o "$tmp"
  echo "$sha  $tmp" | sha256sum --check --status || { echo 'Bazelisk download checksum mismatch.' >&2; exit 1; }
  chmod +x "$tmp"
  mv "$tmp" "$launcher"
fi
echo "$sha  $launcher" | sha256sum --check --status || { echo "Corrupt launcher: remove $launcher and retry." >&2; exit 1; }
export BAZELISK_SKIP_WRAPPER=1
# Keep disposable output state with the checkout, including analyzer output-base siblings.
workspace=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# A bounded shard set coordinates builds with dev wt retirement without per-worktree lock files.
lock_key=$(printf '%s' "$workspace" | sha256sum)
lock_dir="$HOME/.cache/dev/worktree-locks"
mkdir -p "$lock_dir"
exec {worktree_lock}<>"$lock_dir/${lock_key:0:2}"
flock --shared --nonblock --conflict-exit-code 75 "$worktree_lock"

# Locate the first non-startup token, without confusing separated option values
# for commands. Keep its position for local-config insertion below. The unary
# flags match Bazel 9.3.0 startup_options.cc and bazel_startup_options.cc.
command_name=
command_index=0
index=0
startup_value=0
for arg in "$@"; do
  ((index+=1))
  if [[ "$startup_value" == 1 ]]; then
    startup_value=0
    continue
  fi
  case "$arg" in
    --bazelrc|--command_port|--connect_timeout_secs|--local_startup_timeout_secs|\
    --digest_function|--unix_digest_hash_attribute_name|--server_javabase|\
    --host_jvm_args|--host_jvm_profile|--invocation_policy|--io_nice_level|\
    --install_base|--macos_qos_class|--max_idle_secs|--output_base|\
    --output_user_root|--server_jvm_out|--failure_detail_out|\
    --experimental_cgroup_parent|--extra_classpath)
      startup_value=1 ;;
    --) break ;;
    -*) ;;
    *)
      case "$arg" in build|test|run|coverage|mobile-install) command_name=$arg; command_index=$index ;; esac
      break ;;
  esac
done

# Informational commands and explicitly local builds do not need the service.
executor=reapi
endpoint=grpc://127.0.0.1:50051
remote_executor=grpc://127.0.0.1:50051
remote_cache=grpc://127.0.0.1:50051
manual_server=0
expect=
index=0
for arg in "$@"; do
  ((index+=1))
  [[ -n "$command_name" ]] || break
  ((index > command_index)) || continue
  [[ "$arg" != -- ]] || break
  if [[ -n "$expect" ]]; then
    case "$expect" in
      executor) executor=$arg ;; endpoint) endpoint=$arg ;;
      remote_executor) remote_executor=$arg ;; remote_cache) remote_cache=$arg ;;
      config)
        case "$arg" in
          local) executor=local; remote_executor=; remote_cache= ;;
          webrtc-reapi) executor=reapi ;;
          webrtc-cache) executor=cache ;;
        esac ;;
    esac
    expect=
    continue
  fi
  case "$arg" in
    --//crates/pulsebeam-libwebrtc-sys:executor=*) executor=${arg#*=} ;;
    --//crates/pulsebeam-libwebrtc-sys:executor) expect=executor ;;
    --//crates/pulsebeam-libwebrtc-sys:reapi=*) endpoint=${arg#*=} ;;
    --//crates/pulsebeam-libwebrtc-sys:reapi) expect=endpoint ;;
    --remote_executor=*) remote_executor=${arg#*=} ;;
    --remote_executor) expect=remote_executor ;;
    --remote_cache=*) remote_cache=${arg#*=} ;;
    --remote_cache) expect=remote_cache ;;
    --config=local) executor=local; remote_executor=; remote_cache= ;;
    --config) expect=config ;;
    --config=webrtc-reapi) executor=reapi ;;
    --config=webrtc-cache) executor=cache ;;
    //tools/nativelink:server) manual_server=1 ;;
  esac
done
needs_service=0
if [[ "$remote_executor" == grpc://127.0.0.1:50051 || "$remote_cache" == grpc://127.0.0.1:50051 || \
      ( "$executor" != local && "$endpoint" == grpc://127.0.0.1:50051 ) ]]; then
  needs_service=1
fi
if [[ "$arch" == amd64 && -n "$command_name" && "$needs_service" == 1 && \
      ! ( "$command_name" == run && "$manual_server" == 1 ) && \
      "${PULSEBEAM_NATIVELINK_AUTOSTART:-1}" != 0 ]]; then
  python3 "$workspace/tools/nativelink/autostart.py" \
    --workspace "$workspace" --bazelisk "$launcher" --output-base "$workspace/.bazel/output"
fi
if [[ -n "$command_name" && ( "$arch" != amd64 || ( "$command_name" == run && "$manual_server" == 1 ) ) ]]; then
  arguments=()
  index=0
  for arg in "$@"; do
    ((index+=1))
    arguments+=("$arg")
    if ((index == command_index)); then
      arguments+=(--config=local)
    fi
  done
  set -- "${arguments[@]}"
fi
exec "$launcher" "--output_base=$workspace/.bazel/output" "$@"
