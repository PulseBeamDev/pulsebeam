#!/usr/bin/env bash
set -euo pipefail
# Nix supplies only the locked Linux OS environment; build tools remain Bazel-owned.
[[ $(uname -s) == Linux ]] || { echo 'PulseBeam requires a supported Linux host.' >&2; exit 1; }
case $(uname -m) in
  x86_64) arch=amd64; sha=e1508323f347ad1465a887bc5d2bfb91cffc232d11e8e997b623227c6b32fb76 ;;
  aarch64|arm64) arch=arm64; sha=bb608519a440d45d10304eb684a73a2b6bb7699c5b0e5434361661b25f113a5d ;;
  *) echo 'Development supports Linux x86_64; release-only builds also support Linux aarch64.' >&2; exit 1 ;;
esac
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
identity=$(cat "$root/tools/host/flake.nix" "$root/tools/host/flake.lock" | sha256sum)
identity="${identity%% *}:$arch"
if [[ ! -r /etc/pulsebeam-host || $(< /etc/pulsebeam-host) != "$identity" ]]; then
  [[ ${PULSEBEAM_HOST_ACTIVE:-} != 1 ]] || { echo 'Locked OS runtime changed or failed to initialize; restart outside it.' >&2; exit 1; }
  command -v nix >/dev/null || { echo 'Install Nix first; see docs/build.md for the host boundary.' >&2; exit 1; }
  host=$(nix --extra-experimental-features 'nix-command flakes' build --no-link --print-out-paths \
    --no-update-lock-file "path:$root/tools/host#default")
  export PULSEBEAM_HOST_ACTIVE=1
  exec "$host/bin/pulsebeam-host" "$root/bazel" "$@"
fi
[[ -x /usr/bin/mold ]] || { echo 'Locked OS runtime lacks mold; start with ./bazel.' >&2; exit 1; }
export PULSEBEAM_HOST_ENV="$identity"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/pulsebeam/bazelisk-1.27.0-$arch"
mkdir -p "$cache"
launcher="$cache/bazelisk"
if [[ ! -f "$launcher" ]]; then
  command -v curl >/dev/null || { echo 'Install curl and CA certificates to bootstrap Bazel.' >&2; exit 1; }
  tmp=$(mktemp "$cache/download.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  curl --fail --location --retry 3 "https://github.com/bazelbuild/bazelisk/releases/download/v1.27.0/bazelisk-linux-$arch" -o "$tmp"
  echo "$sha  $tmp" | sha256sum --check --status || { echo 'Bazelisk download checksum mismatch.' >&2; exit 1; }
  chmod +x "$tmp"
  mv "$tmp" "$launcher"
fi
echo "$sha  $launcher" | sha256sum --check --status || { echo "Corrupt launcher: remove $launcher and retry." >&2; exit 1; }
export BAZELISK_SKIP_WRAPPER=1
# A server in an older FHS namespace must restart before executing new actions.
exec "$launcher" "--host_jvm_args=-Dpulsebeam.host_env=$identity" "$@"
